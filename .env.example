# ─────────────────────────────────────────────────────────────────────────────
# Local development settings.
#
#   make setup      copies this file to .env (never commit .env)
#   make <target>   loads it through scripts/with-env.sh
#   docker compose  reads it on its own
#
# Format: KEY=value, one per line. Wrap a value in single quotes if it contains
# spaces, #, $, or quotes:  PGPASSWORD='p@ss $word #1'
# Both readers (the shell and Compose) then see exactly the same value.
# A variable already set in your shell wins over this file, for both readers:
#   PGPORT=55432 make dev
#
# Every value has a working default, so an empty .env still runs. In production,
# set these through your platform (secrets manager, Kubernetes Secret, Fly/Render
# dashboard); never ship a .env file.
# ─────────────────────────────────────────────────────────────────────────────


# ── API (Go) ────────────────────────────────────────────────────────────────

# development: human-readable text logs at debug level
# production:  JSON logs at info level, for log collectors
APP_ENV=development

# Minimum log level: debug, info, warn, or error. Empty means info in
# production and debug otherwise. Change it without a rebuild when debugging.
LOG_LEVEL=

# Port the API listens on.
PORT=8080

# Serve /docs and /openapi.yaml from the API. Set false where the API port is
# reachable by people who shouldn't browse your API surface.
DOCS_ENABLED=true

# How long in-flight requests get to finish after SIGTERM before the API exits.
# Keep it shorter than your platform's kill grace period (Kubernetes: 30s).
SHUTDOWN_TIMEOUT=10s


# ── Database ────────────────────────────────────────────────────────────────

# The standard libpq variables, written once and shared: the API builds its
# connection from them, docker compose creates the database with them, and psql
# and other Postgres tools read them directly. The credentials take effect when
# the database volume is first created; after changing them, run `make db-reset`.
PGHOST=localhost
# Host port. If 5432 is already in use, change it here and nothing else.
PGPORT=5432
PGUSER=app
PGPASSWORD=app
PGDATABASE=app
# Use require (or verify-full) for any database outside your machine.
PGSSLMODE=disable

# Hosted Postgres often hands out a single URL instead. When set, it wins over
# the PG* variables above; percent-encode special characters in the password.
# DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require


# ── Auth (Keycloak) ─────────────────────────────────────────────────────────

# Host port for the Keycloak container. Admin console: http://localhost:8180
# (admin/admin). Dev users: alice/alice (user), admin/admin (user + admin).
KEYCLOAK_PORT=8180

# Which access tokens the API accepts. The issuer must match the iss claim
# exactly; the audience must appear in aud (the realm adds it for the web app).
OIDC_ISSUER=http://localhost:8180/realms/app
OIDC_AUDIENCE=api
# Where the API itself reaches Keycloak, when that differs from the issuer.
# Only needed in Docker (http://keycloak:8080/realms/app); leave empty here.
OIDC_DISCOVERY_URL=

# ── Temporal (workflows) ────────────────────────────────────────────────────

# Writes run as workflows: the API starts them, `make dev-worker` (cmd/worker)
# runs them. Both must use the same namespace and task queue.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=app
# Host ports for the dev server and its web UI (http://localhost:8233).
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233


# ── Web (Next.js) ───────────────────────────────────────────────────────────

# Where Next.js forwards /api/* and server components fetch from. The browser
# never calls the API directly, so this is a server-side address (in Docker:
# http://api:8080). Rewrites resolve it at BUILD time, so changing it needs a
# rebuild of the web image.
API_URL=http://localhost:8080

# Port for `make dev-web` and the web container.
WEB_PORT=3000

# Sign-in. The web app's server runs the login and keeps tokens in an encrypted,
# httpOnly cookie; browsers never see a token. APP_URL is this app's public URL
# (the OAuth redirect goes back to it).
APP_URL=http://localhost:3000
AUTH_ISSUER=http://localhost:8180/realms/app
AUTH_CLIENT_ID=web
AUTH_CLIENT_SECRET=dev-web-secret
# Encrypts the session cookie. Required in production: at least 32 random
# characters, e.g. `openssl rand -base64 32`. Empty uses a dev-only secret.
AUTH_SECRET=
# Where the web server reaches Keycloak if not at AUTH_ISSUER (Docker only).
AUTH_INTERNAL_ISSUER=
