# ─────────────────────────────────────────────────────────────────────────────
# Local development settings.
#
#   make setup   copies this file to .env (never commit .env)
#   make ...     exports every variable below to the command it runs
#   docker compose reads .env on its own
#
# Every value has a working default in code, so an empty .env still runs.
# In production, set these through your platform (secrets manager, Kubernetes
# Secret, Fly/Render dashboard); never ship a .env file.
# ─────────────────────────────────────────────────────────────────────────────


# ── API (Go) ────────────────────────────────────────────────────────────────

# development: human-readable text logs at debug level
# production:  JSON logs at info level, for log collectors
APP_ENV=development

# Port the API listens on.
PORT=8080

# Postgres connection string read by the API. It must match the POSTGRES_*
# and DB_PORT values below. Use sslmode=require (or verify-full) for any
# database outside your machine.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# How long in-flight requests get to finish after SIGTERM before the API exits.
# Keep it shorter than your platform's kill grace period (Kubernetes: 30s).
SHUTDOWN_TIMEOUT=10s


# ── Database (docker compose) ───────────────────────────────────────────────

# Credentials for the local Postgres container. They only take effect when the
# database volume is first created; after changing them, run `make db-reset`.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host port for the Postgres container. If 5432 is already in use, change
# this AND the port in DATABASE_URL.
DB_PORT=5432


# ── Web (Next.js) ───────────────────────────────────────────────────────────

# Where Next.js forwards /api/* and /healthz. The browser never calls the API
# directly, so this is a server-side address (in Docker: http://api:8080).
# Next.js resolves it at BUILD time, so changing it needs a rebuild.
API_URL=http://localhost:8080

# Port for `make dev-web` and the web container.
WEB_PORT=3000
