{
  "uid": "app-overview",
  "title": "App overview",
  "tags": [
    "app"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
